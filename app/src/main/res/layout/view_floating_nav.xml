<?xml version="1.0" encoding="utf-8"?>
<!--
    Floating pill navigation.
    The root FrameLayout is the pill itself (ink background set in code);
    this file only declares the sliding lime highlight and the five items.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/navHighlight"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_nav_highlight"
        android:visibility="invisible" />

    <LinearLayout
        android:id="@+id/navItems"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navToday"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/nav_today"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navTodayIcon"
                android:layout_width="@dimen/nav_icon"
                android:layout_height="@dimen/nav_icon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_home"
                app:tint="@color/nav_inactive" />

            <TextView
                android:id="@+id/navTodayLabel"
                style="@style/Text.Wise.NavLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="@dimen/spacing_xxs"
                android:paddingEnd="@dimen/spacing_xxs"
                android:text="@string/nav_today" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navRun"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/nav_run"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navRunIcon"
                android:layout_width="@dimen/nav_icon"
                android:layout_height="@dimen/nav_icon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_run"
                app:tint="@color/nav_inactive" />

            <TextView
                android:id="@+id/navRunLabel"
                style="@style/Text.Wise.NavLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="@dimen/spacing_xxs"
                android:paddingEnd="@dimen/spacing_xxs"
                android:text="@string/nav_run" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navWorkouts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/nav_workouts"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navWorkoutsIcon"
                android:layout_width="@dimen/nav_icon"
                android:layout_height="@dimen/nav_icon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_dumbbell"
                app:tint="@color/nav_inactive" />

            <TextView
                android:id="@+id/navWorkoutsLabel"
                style="@style/Text.Wise.NavLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="@dimen/spacing_xxs"
                android:paddingEnd="@dimen/spacing_xxs"
                android:text="@string/nav_workouts" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProgress"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/nav_progress"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navProgressIcon"
                android:layout_width="@dimen/nav_icon"
                android:layout_height="@dimen/nav_icon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chart"
                app:tint="@color/nav_inactive" />

            <TextView
                android:id="@+id/navProgressLabel"
                style="@style/Text.Wise.NavLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="@dimen/spacing_xxs"
                android:paddingEnd="@dimen/spacing_xxs"
                android:text="@string/nav_progress" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/nav_settings"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/navSettingsIcon"
                android:layout_width="@dimen/nav_icon"
                android:layout_height="@dimen/nav_icon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_settings"
                app:tint="@color/nav_inactive" />

            <TextView
                android:id="@+id/navSettingsLabel"
                style="@style/Text.Wise.NavLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="@dimen/spacing_xxs"
                android:paddingEnd="@dimen/spacing_xxs"
                android:text="@string/nav_settings" />
        </LinearLayout>
    </LinearLayout>
</merge>
