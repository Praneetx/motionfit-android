<?xml version="1.0" encoding="utf-8"?>
<!-- Workouts history (main destination, floating nav present). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_soft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingEnd="@dimen/screen_margin">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Wise.ScreenTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/title_workouts" />

                <ImageButton
                    android:id="@+id/btnAddWorkout"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:background="@drawable/bg_icon_circular"
                    android:contentDescription="@string/content_desc_add"
                    android:padding="@dimen/spacing_md"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_add"
                    app:tint="@color/ink" />
            </LinearLayout>

            <!-- Type filter styled as a text-input-like field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_wise_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/spacing_lg"
                android:paddingEnd="@dimen/spacing_sm">

                <TextView
                    style="@style/Text.Wise.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/workout_type_label" />

                <Spinner
                    android:id="@+id/typeFilter"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:layout_weight="1"
                    android:contentDescription="@string/workout_type_label" />
            </LinearLayout>
        </LinearLayout>

        <!-- Load failure is a real state, not an empty list. -->
        <LinearLayout
            android:id="@+id/workoutsErrorState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/spacing_lg"
            android:layout_marginEnd="@dimen/screen_margin"
            android:background="@drawable/bg_wise_card"
            android:orientation="vertical"
            android:padding="@dimen/card_padding"
            android:visibility="gone">

            <TextView
                style="@style/Text.Wise.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/workouts_error_title" />

            <TextView
                style="@style/Text.Wise.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:text="@string/workouts_error" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryWorkouts"
                style="@style/Widget.Wise.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/action_retry" />
        </LinearLayout>

        <!-- Grouped list card -->
        <LinearLayout
            android:id="@+id/workoutListCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/screen_margin"
            android:layout_marginTop="@dimen/spacing_lg"
            android:layout_marginEnd="@dimen/screen_margin"
            android:layout_marginBottom="@dimen/nav_content_padding"
            android:layout_weight="1"
            android:background="@drawable/bg_wise_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/card_padding"
            android:paddingTop="@dimen/spacing_md"
            android:paddingEnd="@dimen/card_padding"
            android:paddingBottom="@dimen/spacing_md">

            <TextView
                android:id="@+id/workoutsEmpty"
                style="@style/Text.Wise.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/spacing_lg"
                android:text="@string/workouts_empty" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyAddWorkout"
                style="@style/Widget.Wise.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:text="@string/action_add_workout" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/workoutList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <io.github.praneetx.motionfit.views.FloatingNavView
        android:id="@+id/floatingNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/nav_margin_side"
        android:layout_marginEnd="@dimen/nav_margin_side"
        android:layout_marginBottom="@dimen/nav_margin_bottom" />
</FrameLayout>
