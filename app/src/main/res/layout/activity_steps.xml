<?xml version="1.0" encoding="utf-8"?>
<!--
    Steps history screen (main destination, so it carries the floating nav).
    Circular "+" opens the step entry dialog.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_soft">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/nav_content_padding"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingEnd="@dimen/screen_margin">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="@dimen/icon_button_small"
                    android:layout_height="@dimen/icon_button_small"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_back"
                    android:padding="@dimen/spacing_sm"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/ink"
                    android:visibility="gone" />

                <TextView
                    style="@style/Text.Wise.ScreenTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="@dimen/spacing_xs"
                    android:text="@string/title_steps" />

                <ImageButton
                    android:id="@+id/btnEditSteps"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:background="@drawable/bg_icon_circular"
                    android:contentDescription="@string/content_desc_add"
                    android:padding="@dimen/spacing_md"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_add"
                    app:tint="@color/ink" />
            </LinearLayout>

            <!-- Selected day -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:background="@drawable/bg_wise_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:id="@+id/stepsSelectedDate"
                    style="@style/Text.Wise.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/stepsSelectedValue"
                    style="@style/Text.Wise.Hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:autoSizeMaxTextSize="64sp"
                    android:autoSizeMinTextSize="24sp"
                    android:autoSizeStepGranularity="2sp"
                    android:autoSizeTextType="uniform"
                    android:maxLines="1"
                    android:singleLine="true" />

                <TextView
                    style="@style/Text.Wise.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/steps_go_hint" />
            </LinearLayout>

            <!-- Read-only effective automatic-tracking status -->
            <LinearLayout
                android:id="@+id/stepsTrackingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_wise_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/Text.Wise.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/steps_tracking_title" />

                <TextView
                    android:id="@+id/stepsTrackingStatus"
                    style="@style/Text.Wise.MetricLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:accessibilityLiveRegion="polite" />

                <TextView
                    android:id="@+id/stepsTrackingDetail"
                    style="@style/Text.Wise.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageTracking"
                    style="@style/Widget.Wise.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="@string/steps_tracking_manage" />
            </LinearLayout>

            <!-- History -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_wise_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/Text.Wise.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/steps_history_title" />

                <TextView
                    android:id="@+id/stepsEmpty"
                    style="@style/Text.Wise.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/steps_empty" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/stepHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <io.github.praneetx.motionfit.views.FloatingNavView
        android:id="@+id/floatingNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_height"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/nav_margin_side"
        android:layout_marginEnd="@dimen/nav_margin_side"
        android:layout_marginBottom="@dimen/nav_margin_bottom" />
</FrameLayout>
