<?xml version="1.0" encoding="utf-8"?>
<!--
    Short, skippable first-run onboarding.
    Everything is on one scrollable page: privacy, goals and the optional
    automatic-counting explanation. The pinned actions stay above the keyboard.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_soft"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/spacing_xl">

            <TextView
                android:id="@+id/onboardingTitle"
                style="@style/Text.Wise.ScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/onboarding_welcome_title" />

            <TextView
                style="@style/Text.Wise.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/onboarding_welcome_body" />

            <!-- Privacy: plain text, no permission prompt. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:background="@drawable/bg_wise_card_dark"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/Text.Wise.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_privacy_title"
                    android:textColor="@color/primary" />

                <TextView
                    style="@style/Text.Wise.Caption.OnDark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:alpha="0.9"
                    android:text="@string/onboarding_privacy_body" />
            </LinearLayout>

            <!-- Existing goals are shown and only saved on Finish. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_wise_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/Text.Wise.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/onboarding_goals_title" />

                <TextView
                    style="@style/Text.Wise.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/onboarding_goals_body" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Wise.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:hint="@string/goals_step_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/onboardingStepGoalInput"
                        style="@style/Widget.Wise.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="7"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Wise.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:hint="@string/goals_minutes_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/onboardingMinutesGoalInput"
                        style="@style/Widget.Wise.TextInputEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="4"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Optional automatic counting. No permission is requested here. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_wise_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/onboardingAutoLabel"
                        style="@style/Text.Wise.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:labelFor="@id/onboardingAutoSwitch"
                        android:text="@string/onboarding_auto_title" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/onboardingAutoSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_min"
                        android:minWidth="@dimen/touch_min" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Wise.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/onboarding_auto_body" />

                <TextView
                    style="@style/Text.Wise.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/onboarding_auto_permission_note" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Pinned actions: Finish is primary, Skip is always available. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/canvas_soft"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/spacing_lg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinishOnboarding"
            style="@style/Widget.Wise.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_finish" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkipOnboarding"
            style="@style/Widget.Wise.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/onboarding_skip" />
    </LinearLayout>
</LinearLayout>
