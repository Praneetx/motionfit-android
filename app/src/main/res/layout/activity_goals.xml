<?xml version="1.0" encoding="utf-8"?>
<!--
    Goals (pushed screen: no floating nav).
    One white card per goal with a large heavy value, circular -/+ steppers,
    a progress bar for today and the real percentage. Save is pinned.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_soft"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/spacing_xl">

            <!-- Circular back + title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:background="@drawable/bg_icon_circular"
                    android:contentDescription="@string/action_back"
                    android:padding="@dimen/spacing_md"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/ink" />

                <TextView
                    style="@style/Text.Wise.ScreenTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_lg"
                    android:layout_weight="1"
                    android:text="@string/title_goals" />
            </LinearLayout>

            <!-- Step goal card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:background="@drawable/bg_wise_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/Text.Wise.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/goals_step_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/stepGoalMinus"
                        android:layout_width="@dimen/touch_min"
                        android:layout_height="@dimen/touch_min"
                        android:background="@drawable/bg_icon_circle_soft"
                        android:contentDescription="@string/content_desc_decrease"
                        android:padding="@dimen/spacing_md"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_minus"
                        android:tint="@color/ink" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/stepGoalInput"
                        style="@style/Widget.Wise.BareNumberInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:maxLength="7" />

                    <ImageButton
                        android:id="@+id/stepGoalPlus"
                        android:layout_width="@dimen/touch_min"
                        android:layout_height="@dimen/touch_min"
                        android:background="@drawable/bg_icon_circle_soft"
                        android:contentDescription="@string/content_desc_increase"
                        android:padding="@dimen/spacing_md"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_add"
                        android:tint="@color/ink" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/stepGoalProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/progress_bar_height"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="@color/canvas_soft"
                    android:progressTint="@color/primary" />

                <TextView
                    android:id="@+id/stepGoalPercent"
                    style="@style/Text.Wise.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm" />
            </LinearLayout>

            <!-- Workout minutes goal card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:background="@drawable/bg_wise_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/Text.Wise.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/goals_minutes_label" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/minuteGoalMinus"
                        android:layout_width="@dimen/touch_min"
                        android:layout_height="@dimen/touch_min"
                        android:background="@drawable/bg_icon_circle_soft"
                        android:contentDescription="@string/content_desc_decrease"
                        android:padding="@dimen/spacing_md"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_minus"
                        android:tint="@color/ink" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/minutesGoalInput"
                        style="@style/Widget.Wise.BareNumberInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:maxLength="4" />

                    <ImageButton
                        android:id="@+id/minuteGoalPlus"
                        android:layout_width="@dimen/touch_min"
                        android:layout_height="@dimen/touch_min"
                        android:background="@drawable/bg_icon_circle_soft"
                        android:contentDescription="@string/content_desc_increase"
                        android:padding="@dimen/spacing_md"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_add"
                        android:tint="@color/ink" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/minuteGoalProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/progress_bar_height"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="@color/canvas_soft"
                    android:progressTint="@color/accent_cyan" />

                <TextView
                    android:id="@+id/minuteGoalPercent"
                    style="@style/Text.Wise.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm" />
            </LinearLayout>

            <TextView
                style="@style/Text.Wise.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/goals_caption" />
        </LinearLayout>
    </ScrollView>

    <!-- Pinned primary action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/spacing_md"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/spacing_lg">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveGoals"
            style="@style/Widget.Wise.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_save_goals" />
    </LinearLayout>
</LinearLayout>
