<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Dotted style names imply an implicit parent in AAPT (Text.Wise.Hero
        inherits Text.Wise), so these two bases must exist AND declare an empty
        parent so AAPT does not look for a style literally named "Text"/"Widget".
    -->
    <style name="Text.Wise" parent="" />
    <style name="Widget.Wise" parent="" />

    <!-- ==================================================================
         TYPOGRAPHY
         Roles are strict: Inter Black (900-ish) only for hero numbers and
         screen titles; Inter SemiBold for section titles, labels, buttons;
         Inter Regular for body. Wise Sans is proprietary, so Inter at 900
         is used as documented substitute in DESIGN-wise.md.
         ================================================================== -->

    <style name="Text.Wise.Hero">
        <item name="android:fontFamily">@font/inter_black</item>
        <item name="android:textSize">@dimen/text_hero</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="Text.Wise.Hero.OnDark">
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Text.Wise.ScreenTitle">
        <item name="android:fontFamily">@font/inter_black</item>
        <item name="android:textSize">@dimen/text_screen_title</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.Wise.SectionTitle">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">@dimen/text_section</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Wise.AppBarTitle">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Text.Wise.Body">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/body</item>
    </style>

    <style name="Text.Wise.BodyOnCard">
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Text.Wise.BodyStrong">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Text.Wise.Secondary">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">@dimen/text_secondary</item>
        <item name="android:textColor">@color/body</item>
    </style>

    <style name="Text.Wise.Caption">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/mute</item>
    </style>

    <style name="Text.Wise.Caption.OnDark">
        <item name="android:textColor">@color/canvas_soft</item>
    </style>

    <style name="Text.Wise.Metric">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="Text.Wise.MetricLarge">
        <item name="android:fontFamily">@font/inter_black</item>
        <item name="android:textSize">@dimen/text_section</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="Text.Wise.Label">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">@dimen/text_secondary</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- ==================================================================
         BUTTONS — 24dp pill geometry, no elevation
         ================================================================== -->

    <style name="Widget.Wise.Button" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/spacing_xl</item>
        <item name="android:paddingEnd">@dimen/spacing_xl</item>
        <item name="cornerRadius">@dimen/radius_xl</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.Wise.Button.Primary" parent="Widget.Wise.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <style name="Widget.Wise.Button.Secondary" parent="Widget.Wise.Button">
        <item name="backgroundTint">@color/canvas_soft</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Widget.Wise.Button.Tertiary" parent="Widget.Wise.Button">
        <item name="backgroundTint">@color/canvas</item>
        <item name="android:textColor">@color/ink</item>
        <item name="strokeColor">@color/ink</item>
        <item name="strokeWidth">@dimen/hairline</item>
    </style>

    <style name="Widget.Wise.Button.Destructive" parent="Widget.Wise.Button.Tertiary">
        <item name="android:textColor">@color/negative</item>
        <item name="strokeColor">@color/negative</item>
    </style>

    <style name="Widget.Wise.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">@dimen/text_secondary</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Segmented control segment (ink when checked, transparent otherwise) -->
    <style name="Widget.Wise.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">@dimen/text_secondary</item>
        <item name="android:textColor">@color/segment_text</item>
        <item name="backgroundTint">@color/segment_bg</item>
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">0dp</item>
        <item name="rippleColor">@color/primary_active</item>
    </style>

    <!-- ==================================================================
         TEXT INPUT — 1dp ink border, 12dp radius, white fill
         ================================================================== -->

    <style name="Widget.Wise.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/canvas</item>
        <item name="boxStrokeColor">@color/ink</item>
        <item name="boxStrokeWidth">@dimen/hairline</item>
        <item name="boxStrokeWidthFocused">@dimen/hairline</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="hintTextColor">@color/mute</item>
        <item name="android:textColorHint">@color/mute</item>
        <item name="errorTextColor">@color/negative</item>
        <item name="errorIconTint">@color/negative</item>
        <item name="boxCollapsedPaddingTop">0dp</item>
    </style>

    <style name="Widget.Wise.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/mute</item>
    </style>

    <!-- Bare numeric value used inside the Goals cards -->
    <style name="Widget.Wise.BareNumberInput" parent="Widget.Wise.TextInputEditText">
        <item name="android:fontFamily">@font/inter_black</item>
        <item name="android:textSize">@dimen/text_screen_title</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:background">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:minWidth">80dp</item>
    </style>

    <!-- ==================================================================
         FLOATING NAV
         ================================================================== -->

    <style name="Text.Wise.NavLabel">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:includeFontPadding">false</item>
    </style>

</resources>
