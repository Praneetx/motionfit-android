<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         Wise palette — values taken from DESIGN-wise.md (source of truth)
         ============================================================ -->

    <!-- Brand & accent -->
    <color name="primary">#9FE870</color>
    <color name="on_primary">#0E0F0C</color>
    <color name="primary_active">#CDFFAD</color>
    <color name="primary_neutral">#C5EDAB</color>
    <color name="primary_pale">#E2F6D5</color>

    <!-- Surface -->
    <color name="canvas">#FFFFFF</color>
    <color name="canvas_soft">#E8EBE6</color>

    <!-- Text -->
    <color name="ink">#0E0F0C</color>
    <color name="ink_deep">#163300</color>
    <color name="body">#454745</color>
    <color name="mute">#868685</color>

    <!-- Semantic -->
    <color name="positive">#2EAD4B</color>
    <color name="positive_deep">#054D28</color>
    <color name="warning">#FFD11A</color>
    <color name="warning_deep">#B86700</color>
    <color name="warning_content">#4A3B1C</color>
    <color name="negative">#D03238</color>
    <color name="negative_deep">#A72027</color>
    <color name="negative_darkest">#A7000D</color>
    <color name="negative_bg">#320707</color>

    <!-- Illustrative accents (charts / progress only, never buttons or nav) -->
    <color name="accent_orange">#FFC091</color>
    <color name="accent_cyan">#38C8FF</color>

    <!-- Absolute neutrals -->
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <color name="transparent">#00000000</color>

    <!-- ============================================================
         Backward-compatible aliases.
         Some Java/older resources still reference these names; they are
         re-pointed at the Wise tokens so nothing dangles.
         ============================================================ -->
    <color name="primary_dark">@color/ink</color>
    <color name="primary_light">@color/primary_pale</color>
    <color name="primary_container">@color/primary_pale</color>
    <color name="on_primary_container">@color/ink_deep</color>
    <color name="secondary">@color/accent_cyan</color>
    <color name="secondary_container">@color/canvas_soft</color>
    <color name="on_secondary_container">@color/ink</color>
    <color name="background">@color/canvas_soft</color>
    <color name="surface">@color/canvas</color>
    <color name="surface_variant">@color/canvas_soft</color>
    <color name="text_primary">@color/ink</color>
    <color name="text_secondary">@color/body</color>
    <color name="divider">@color/canvas_soft</color>
    <color name="success">@color/positive</color>
    <color name="error">@color/negative</color>
    <color name="progress_track">@color/canvas_soft</color>

    <!-- 70% white for inactive floating-nav icons/labels -->
    <color name="nav_inactive">#B3FFFFFF</color>
</resources>
